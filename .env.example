# Postgres — matches docker-compose.yml. 5433 on the host so a locally
# installed Postgres on 5432 is left alone.
DATABASE_URL=postgresql://nextora:nextora@localhost:5433/nextora

# Better Auth. Generate a real secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-32-byte-random-string
BETTER_AUTH_URL=http://localhost:3000
